{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "$comment": "Decision: squash-only merges with the PR title as the release commit. See docs/adr/0004-squash-only-merges-the-pr-title-is-the-release-commit.md.",
      "release-type": "simple",
      "package-name": "ai-migration-kit",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
